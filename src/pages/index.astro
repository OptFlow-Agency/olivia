	@media (prefers-reduced-motion: reduce) { .stem, .leaf, .olive { animation: none !important; stroke-dashoffset: 0; opacity: 1; } .slide, .slide img { transition: none; transform: none; } }


	/* statement */
	.statement { background: var(--stone); color: var(--espresso); padding: clamp(4rem, 10vw, 8rem) var(--gutter); display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; }
