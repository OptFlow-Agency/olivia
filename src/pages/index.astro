	.pips i.on { background: var(--stone); }

	/* header over the hero */
	.mono { width: 3.5rem; height: 3.5rem; display: grid; place-items: center; border: 1px solid var(--tan); border-radius: 50%; text-decoration: none; color: var(--tan); font: 500 1.9rem/1 var(--serif); transition: background-color 0.3s, color 0.3s; }
	.mono:hover { background: var(--tan); color: var(--paper); }
