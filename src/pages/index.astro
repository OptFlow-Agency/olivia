	/* buttons */
	.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.9rem; border-radius: 999px; font: 600 0.95rem/1 var(--sans); letter-spacing: 0.02em; text-decoration: none; cursor: pointer; border: 1px solid var(--paper); transition: background-color 0.3s, color 0.3s, transform 0.3s var(--ease); }
