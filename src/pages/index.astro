---
import { Image, getImage } from 'astro:assets';
import plateImg from '../assets/hero_plate_1792358181898.jpg';
import roomImg from '../assets/room_dining_1792358177917.jpg';
import courseImg from '../assets/first_course_1792358178781.jpg';
import terraceImg from '../assets/terrace_1792358179714.jpg';
import barImg from '../assets/bar_1792358180560.jpg';
import eventsImg from '../assets/events_1792358182038.jpg';
import zelligeImg from '../assets/zellige_pattern_1792358180973.jpg';

const zellige = await getImage({ src: zelligeImg, width: 520, format: 'webp' });
// Sample content throughout: menu, prices, hours, address and contact details are
// placeholders and must be replaced with the restaurant's own.
const menu = [
	{
		id: 'small',
		title: 'To begin',
		note: 'Small plates, built to share',
		items: [
			{ name: 'Burrata, blistered tomato, olive oil', desc: 'Warm focaccia, basil oil, flaky salt', price: '16', tag: 'V' },
			{ name: 'Beef tartare', desc: 'Capers, shallot, cured yolk, rye crisp', price: '19' },
			{ name: 'Charred leeks', desc: 'Hazelnut romesco, aged sheep’s cheese', price: '14', tag: 'V' },
			{ name: 'Scallop crudo', desc: 'Green apple, fennel pollen, lemon oil', price: '21', tag: 'GF' },
			{ name: 'Wild mushroom velouté', desc: 'Chestnut, thyme, brown butter', price: '15', tag: 'V' },
		],
	},
	{
		id: 'mains',
		title: 'The table',
		note: 'From the kitchen and the grill',
		items: [
			{ name: 'Roast monkfish', desc: 'Saffron beurre blanc, braised fennel, samphire', price: '38', tag: 'GF' },
			{ name: 'Dry-aged duck breast', desc: 'Cherry jus, celeriac purée, hispi cabbage', price: '42' },
			{ name: 'Hand-rolled pappardelle', desc: 'Slow-cooked lamb shoulder, rosemary, pecorino', price: '29' },
			{ name: 'Herb-crusted rack of lamb', desc: 'Pommes anna, spring greens, mint salsa verde', price: '46' },
			{ name: 'Roasted celeriac', desc: 'Black garlic, walnut, sage, aged vinegar', price: '26', tag: 'V' },
		],
	},
	{
		id: 'sweet',
		title: 'To finish',
		note: 'Desserts and cheese',
		items: [
			{ name: 'Dark chocolate marquise', desc: 'Salted caramel, hazelnut praline, crème fraîche', price: '14', tag: 'GF' },
			{ name: 'Olive oil cake', desc: 'Poached citrus, honeyed mascarpone', price: '13', tag: 'V' },
			{ name: 'Burnt vanilla cheesecake', desc: 'Roasted plum, brown sugar crumb', price: '14', tag: 'V' },
			{ name: 'Selection of cheeses', desc: 'Three European cheeses, quince, toasted walnut bread', price: '18' },
		],
	},
	{
		id: 'tasting',
		title: 'Tasting',
		note: 'Six courses, the whole table',
		items: [
			{ name: 'The tasting menu', desc: 'Six courses chosen by the kitchen from what is best that week. Whole table only.', price: '95' },
			{ name: 'With paired wines', desc: 'Small pours from the growers’ list, one with each course', price: '65' },
			{ name: 'Vegetarian tasting', desc: 'The same six courses, built around the garden and the grain store', price: '85', tag: 'V' },
		],
	},
];

// Olive sprig: leaves placed along a quadratic stem so the drawing is generated, not hand-pasted.
const P0 = [-150, 140], P1 = [-20, -10], P2 = [150, -140];
const bez = (t: number) => ({
	x: (1 - t) ** 2 * P0[0] + 2 * (1 - t) * t * P1[0] + t ** 2 * P2[0],
	y: (1 - t) ** 2 * P0[1] + 2 * (1 - t) * t * P1[1] + t ** 2 * P2[1],
	a: (Math.atan2(2 * (1 - t) * (P1[1] - P0[1]) + 2 * t * (P2[1] - P1[1]), 2 * (1 - t) * (P1[0] - P0[0]) + 2 * t * (P2[0] - P1[0])) * 180) / Math.PI,
});
const leaves = [0.12, 0.24, 0.36, 0.48, 0.6, 0.72, 0.84].flatMap((t, i) => {
	const p = bez(t);
	const size = 1 - Math.abs(t - 0.5) * 0.5;
	return [
		{ ...p, rot: p.a - 52, size, i },
		{ ...p, rot: p.a + 52, size, i: i + 0.5 },
	];
});
const tip = bez(1);
const hours = [
	['Monday', 'Closed'],
	['Tuesday – Thursday', '18:00 – 22:30'],
	['Friday – Saturday', '18:00 – 23:30'],
	['Sunday', '12:30 – 15:30'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#65492C" />
		<meta name="description" content="Olivia is a modern European restaurant. Browse the menu, find our hours and location, and enquire about private dining." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>Olivia — Modern European Restaurant</title>
	</head>
	<body>
		<a class="skip" href="#menu">Skip to the menu</a>

		<header class="bar" id="top">
			<a class="mono" href="#top" aria-label="Olivia, home"><span>O</span></a>
			<button class="burger" type="button" aria-expanded="false" aria-controls="nav">
				<span class="sr">Menu</span>
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
			</button>
			<nav id="nav" aria-label="Main">
				<a href="#menu">Menu</a>
				<a href="#room">The room</a>
				<a href="#events">Private events</a>
				<a href="#visit">Visit</a>
				<a class="nav-call" href="tel:0000000000">00 00 00 00 00</a>
			</nav>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="slides" aria-hidden="true">
					<div class="slide on"><Image src={roomImg} alt="" widths={[800, 1200, 1376]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
					<div class="slide"><Image src={barImg} alt="" widths={[800, 1200]} sizes="100vw" /></div>
					<div class="slide"><Image src={terraceImg} alt="" widths={[800, 1200]} sizes="100vw" /></div>
					<div class="slide"><Image src={eventsImg} alt="" widths={[800, 1200, 1376]} sizes="100vw" /></div>
				</div>

				<div class="hero-center">
					<span class="orn" aria-hidden="true"><i></i><b></b></span>
					<h1 id="hero-title" class="mark">Olivia</h1>
					<p class="tagline">A modern European table, set slowly</p>
					<div class="actions">
						<a class="btn btn-fill" href="#menu">View the menu</a>
						<a class="btn btn-line" href="#visit">Find us</a>
					</div>
				</div>

				<button class="arrow arrow-prev" type="button" aria-label="Previous photo">
					<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6" /></svg>
				</button>
				<button class="arrow arrow-next" type="button" aria-label="Next photo">
					<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
				</button>
				<div class="pips" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i></div>

			</section>

			<section class="statement" aria-label="About Olivia">
				<p>
					We cook what the week gives us and set it down without fuss: bread from our own oven, vegetables with their soil still in memory, fish that arrived this morning.
				</p>
				<div class="statement-side">
				<div class="plate" aria-hidden="true">
					<div class="plate-photo">
						<Image class="plate-img" src={plateImg} alt="" width={900} loading="eager" fetchpriority="high" />
					</div>
					<svg viewBox="0 0 800 800">
						<g transform="translate(400 400)">
							<path class="stem" pathLength="1" d={`M${P0[0]} ${P0[1]} Q${P1[0]} ${P1[1]} ${P2[0]} ${P2[1]}`} />
							{leaves.map((l) => (
								<path
									class="leaf"
									style={`--d:${(0.5 + l.i * 0.09).toFixed(2)}s`}
									transform={`translate(${l.x.toFixed(1)} ${l.y.toFixed(1)}) rotate(${l.rot.toFixed(1)}) scale(${(l.size * 1.5).toFixed(2)})`}
									d="M0 0 C 14 -11 46 -11 62 0 C 46 11 14 11 0 0Z"
								/>
							))}
							<path
								class="leaf"
								style="--d:1.6s"
								transform={`translate(${tip.x.toFixed(1)} ${tip.y.toFixed(1)}) rotate(${tip.a.toFixed(1)}) scale(1.1)`}
								d="M0 0 C 14 -11 46 -11 62 0 C 46 11 14 11 0 0Z"
							/>
							<circle class="olive" cx="-56" cy="52" r="11" />
							<circle class="olive" cx="-18" cy="22" r="9" />
						</g>
					</svg>
				</div>
				<ul>
					<li>A short seasonal menu</li>
					<li>Wines from small European growers</li>
					<li>Room for the occasional long table</li>
				</ul>
				</div>
			</section>

			<section class="carte" id="menu" aria-labelledby="menu-title">
				<div class="carte-side">
					<h2 id="menu-title">The menu</h2>
					<div class="tabs" role="tablist" aria-label="Menu sections">
						{menu.map((m, i) => (
							<button
								type="button"
								role="tab"
								id={`tab-${m.id}`}
								aria-controls={`panel-${m.id}`}
								aria-selected={i === 0 ? 'true' : 'false'}
								tabindex={i === 0 ? 0 : -1}
							>
								{m.title}
							</button>
						))}
					</div>
					<p class="legend">V vegetarian &nbsp;·&nbsp; GF gluten-free<br />Please tell us about any allergies.</p>
				</div>

				<div class="carte-body">
					{menu.map((m, i) => (
						<div class="panel" role="tabpanel" id={`panel-${m.id}`} aria-labelledby={`tab-${m.id}`} hidden={false} data-active={i === 0 ? 'true' : 'false'}>
							<h3>{m.title}<span>{m.note}</span></h3>
							<ul class="dishes">
								{m.items.map((d) => (
									<li>
										<div class="dish-top">
											<span class="dish-name">{d.name}{d.tag && <abbr class="tag" title={d.tag === 'V' ? 'Vegetarian' : 'Gluten-free'}>{d.tag}</abbr>}</span>
											<span class="leader" aria-hidden="true"></span>
											<span class="price">{d.price}</span>
										</div>
										<p>{d.desc}</p>
									</li>
								))}
							</ul>
						</div>
					))}
					<p class="sample">Sample menu and prices. Replace with the kitchen’s own.</p>
				</div>
			</section>

			<section class="room" id="room" aria-labelledby="room-title">
				<h2 id="room-title">The room</h2>
				<div class="mosaic">
					<figure class="t-wide">
						<Image src={roomImg} alt="The dining room at golden hour: arched windows, walnut-toned tables set with stoneware and candles" widths={[640, 960, 1376]} sizes="(max-width: 52rem) 100vw, 64vw" />
						<figcaption>The dining room</figcaption>
					</figure>
					<figure class="t-tall">
						<Image src={courseImg} alt="Charred leek with hazelnut romesco on a stone-grey plate, seen from above" widths={[480, 720, 896]} sizes="(max-width: 52rem) 100vw, 32vw" />
						<figcaption>The first course</figcaption>
					</figure>
					<figure class="t-sq">
						<Image src={terraceImg} alt="The terrace at dusk: a linen-covered table under a canvas awning, lit by lanterns" widths={[480, 720, 1200]} sizes="(max-width: 52rem) 100vw, 40vw" />
						<figcaption>The terrace</figcaption>
					</figure>
					<figure class="t-sq2">
						<Image src={barImg} alt="The bar: an arched plaster niche of wine bottles and glasses above a walnut counter" widths={[480, 720, 1200]} sizes="(max-width: 52rem) 100vw, 55vw" />
						<figcaption>The bar</figcaption>
					</figure>
					<p class="sample sample-room">Images are AI-generated placeholders. Replace with photographs of the restaurant.</p>
				</div>
			</section>

			<section class="events" id="events" aria-labelledby="events-title">
				<figure class="events-photo">
					<Image src={eventsImg} alt="A long walnut table set for a private dinner beneath stone arches, lit by candles" widths={[800, 1200, 1376]} sizes="100vw" />
				</figure>
				<div class="events-copy">
					<h2 id="events-title">Private dining</h2>
					<p>
						Birthdays, anniversaries and quiet business dinners. Tell us the date and the size of the party and we’ll shape a menu, a table and an evening around it.
					</p>
					<ul class="formats">
						<li><strong>The dining room</strong><span>A long table in the main room, set for your party</span></li>
						<li><strong>The terrace</strong><span>Evening drinks and dinner under the open sky</span></li>
						<li><strong>The whole restaurant</strong><span>Exclusive use, from the first glass to the last</span></li>
					</ul>
				</div>

				<form class="enquiry" novalidate>
					<h3>Send an enquiry</h3>
					<label class="field"><span class="lbl">Your name</span><input name="name" type="text" autocomplete="name" placeholder="Full name" required /></label>
					<label class="field"><span class="lbl">Email</span><input name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
					<div class="pair">
						<div class="field" data-pop>
							<span class="lbl" id="date-lbl">Preferred date</span>
							<button class="ctl" type="button" id="date-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="cal" aria-labelledby="date-lbl date-val">
								<span class="val ph" id="date-val">Select a date</span>
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="1.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
							</button>
							<input type="hidden" name="date" />
							<div class="pop cal" id="cal" role="dialog" aria-label="Choose a date" hidden>
								<div class="cal-head">
									<button type="button" class="cal-nav" data-dir="-1" aria-label="Previous month"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
									<span class="cal-title" aria-live="polite"></span>
									<button type="button" class="cal-nav" data-dir="1" aria-label="Next month"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
								</div>
								<div class="cal-week" aria-hidden="true"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div>
								<div class="cal-grid"></div>
							</div>
						</div>
						<div class="field" data-pop>
							<span class="lbl" id="guests-lbl">Guests</span>
							<button class="ctl" type="button" id="guests-btn" aria-haspopup="listbox" aria-expanded="false" aria-controls="guests-list" aria-labelledby="guests-lbl guests-val">
								<span class="val ph" id="guests-val">Select</span>
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
							</button>
							<input type="hidden" name="guests" />
							<ul class="pop list" id="guests-list" role="listbox" aria-labelledby="guests-lbl" tabindex="-1" hidden></ul>
						</div>
					</div>
					<label class="field"><span class="lbl">Anything we should know</span><textarea name="message" rows="4" placeholder="Occasion, dietary needs, preferred format"></textarea></label>
					<button class="btn btn-fill" type="submit">Send enquiry</button>
					<p class="status" role="status" aria-live="polite"></p>
				</form>
			</section>

			<section class="visit" id="visit" aria-labelledby="visit-title">
				<h2 id="visit-title">Visit</h2>
				<div class="visit-grid">
					<div class="hours">
						<h3>Opening hours</h3>
						<table>
							<tbody>
								{hours.map(([d, h]) => (
									<tr><th scope="row">{d}</th><td>{h}</td></tr>
								))}
							</tbody>
						</table>
						<p class="small">Kitchen closes thirty minutes before the room.</p>
					</div>
					<address>
						<h3>Find us</h3>
						<p>12 Rue de l’Olivier<br />Old Town, 00000</p>
						<p><a href="tel:0000000000">00 00 00 00 00</a><br /><a href="mailto:hello@olivia.example">hello@olivia.example</a></p>
					</address>
					<div class="map" role="img" aria-label="Map placeholder showing the restaurant location">
						<svg viewBox="0 0 480 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
							<rect class="f-walnut" width="480" height="340" />
							<g class="st-taupe" stroke-width="10" fill="none" stroke-linecap="round" opacity=".7">
								<path d="M-10 90L190 120L330 60L500 100" />
								<path d="M140 -10L170 130L120 350" />
								<path d="M-10 250L250 220L500 270" />
								<path d="M330 60L360 190L330 350" />
							</g>
							<path class="f-tan" opacity=".55" d="M360 190L500 170V300L330 330Z" />
							<g transform="translate(224 150)">
								<path class="f-paper" d="M0 0C-22-26-34-40-34-58a34 34 0 0 1 68 0C34-40 22-26 0 0Z" />
								<circle class="f-espresso" cy="-58" r="12" />
							</g>
						</svg>
						<span>Map placeholder</span>
					</div>
				</div>
			</section>
		</main>

		<footer style={`--zellige:url(${zellige.src})`}>
			<p class="wordmark">Olivia</p>
			<p class="small">Modern European restaurant. Sample content: menu, prices, hours and contact details are placeholders.</p>
			<a href="#top">Back to top</a>
		</footer>

		<script is:inline>
			document.documentElement.classList.add('js');


			// hero slideshow
			const slides = [...document.querySelectorAll('.slide')];
			const pips = [...document.querySelectorAll('.pips i')];
			let cur = 0, timer;
			const show = (n) => {
				cur = (n + slides.length) % slides.length;
				slides.forEach((el, i) => el.classList.toggle('on', i === cur));
				pips.forEach((el, i) => el.classList.toggle('on', i === cur));
			};
			const play = () => {
				clearInterval(timer);
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => show(cur + 1), 6500);
			};
			document.querySelector('.arrow-prev').addEventListener('click', () => { show(cur - 1); play(); });
			document.querySelector('.arrow-next').addEventListener('click', () => { show(cur + 1); play(); });
			play();

			// header turns solid once the hero is scrolled past
			const bar = document.querySelector('.bar');
			const onScroll = () => bar.classList.toggle('solid', scrollY > innerHeight * 0.6);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// draw the olive sprig when the intro scrolls into view
			const plate = document.querySelector('.plate');
			if ('IntersectionObserver' in window) {
				const po = new IntersectionObserver((e) => e[0].isIntersecting && (plate.classList.add('in'), po.disconnect()), { threshold: 0.4 });
				po.observe(plate);
			} else plate.classList.add('in');

			// mobile nav
			const burger = document.querySelector('.burger');
			const nav = document.getElementById('nav');
			burger.addEventListener('click', () => {
				const open = burger.getAttribute('aria-expanded') === 'true';
				burger.setAttribute('aria-expanded', String(!open));
				nav.classList.toggle('open', !open);
			});
			nav.addEventListener('click', (e) => {
				if (e.target.closest('a')) {
					burger.setAttribute('aria-expanded', 'false');
					nav.classList.remove('open');
				}
			});

			// menu tabs
			const tabs = [...document.querySelectorAll('[role="tab"]')];
			const select = (tab, focus) => {
				tabs.forEach((t) => {
					const on = t === tab;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					document.getElementById(t.getAttribute('aria-controls')).dataset.active = String(on);
				});
				if (focus) tab.focus();
			};
			tabs.forEach((t, i) => {
				t.addEventListener('click', () => select(t));
				t.addEventListener('keydown', (e) => {
					const k = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
					if (k) {
						e.preventDefault();
						select(tabs[(i + k + tabs.length) % tabs.length], true);
					}
				});
			});

			// reveal rows and tiles once as they enter
			if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const io = new IntersectionObserver(
					(entries) => entries.forEach((en) => en.isIntersecting && (en.target.classList.add('in'), io.unobserve(en.target))),
					{ rootMargin: '0px 0px -8% 0px' }
				);
				document.querySelectorAll('.mosaic figure, .formats li, .hours, address, .map').forEach((el) => {
					el.classList.add('rv');
					io.observe(el);
				});
			}


			// custom date picker and guests select
			const closePops = (except) => document.querySelectorAll('[data-pop]').forEach((f) => {
				if (f === except) return;
				f.querySelector('.pop').hidden = true;
				f.querySelector('.ctl').setAttribute('aria-expanded', 'false');
			});
			const setOpen = (field, open) => {
				closePops(open ? field : null);
				field.querySelector('.pop').hidden = !open;
				field.querySelector('.ctl').setAttribute('aria-expanded', String(open));
			};
			document.addEventListener('click', (e) => { if (!e.target.closest('[data-pop]')) closePops(); });
			document.querySelectorAll('[data-pop]').forEach((f) => f.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !f.querySelector('.pop').hidden) { e.stopPropagation(); setOpen(f, false); f.querySelector('.ctl').focus(); }
			}));

			// calendar
			const dateField = document.getElementById('date-btn').closest('[data-pop]');
			const dateBtn = document.getElementById('date-btn');
			const dateVal = document.getElementById('date-val');
			const dateInput = dateField.querySelector('input[name="date"]');
			const calGrid = dateField.querySelector('.cal-grid');
			const calTitle = dateField.querySelector('.cal-title');
			const prevBtn = dateField.querySelector('[data-dir="-1"]');
			const today = new Date(); today.setHours(0, 0, 0, 0);
			let view = new Date(today.getFullYear(), today.getMonth(), 1);
			let picked = null;
			const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
			const longDate = (d) => d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
			const renderCal = () => {
				calTitle.textContent = view.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
				prevBtn.disabled = view <= new Date(today.getFullYear(), today.getMonth(), 1);
				const lead = (view.getDay() + 6) % 7;
				const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
				calGrid.innerHTML = '<i></i>'.repeat(lead);
				for (let n = 1; n <= days; n++) {
					const d = new Date(view.getFullYear(), view.getMonth(), n);
					const b = document.createElement('button');
					b.type = 'button'; b.textContent = n; b.dataset.iso = iso(d);
					b.setAttribute('aria-label', longDate(d));
					if (d < today) b.disabled = true;
					if (+d === +today) b.classList.add('today');
					b.setAttribute('aria-pressed', String(picked && +picked === +d));
					calGrid.append(b);
				}
			};
			const focusDay = () => (calGrid.querySelector('[aria-pressed="true"]') || calGrid.querySelector('.today:not(:disabled)') || calGrid.querySelector('button:not(:disabled)'))?.focus();
			dateBtn.addEventListener('click', () => {
				const open = dateField.querySelector('.pop').hidden;
				if (open) { if (picked) view = new Date(picked.getFullYear(), picked.getMonth(), 1); renderCal(); }
				setOpen(dateField, open);
				if (open) focusDay();
			});
			dateField.querySelectorAll('.cal-nav').forEach((b) => b.addEventListener('click', () => {
				view = new Date(view.getFullYear(), view.getMonth() + Number(b.dataset.dir), 1);
				renderCal();
			}));
			calGrid.addEventListener('click', (e) => {
				const b = e.target.closest('button'); if (!b || b.disabled) return;
				const [y, m, d] = b.dataset.iso.split('-').map(Number);
				picked = new Date(y, m - 1, d);
				dateInput.value = b.dataset.iso;
				dateVal.textContent = picked.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
				dateVal.classList.remove('ph');
				setOpen(dateField, false); dateBtn.focus();
			});
			calGrid.addEventListener('keydown', (e) => {
				const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key];
				if (!step) return;
				e.preventDefault();
				const all = [...calGrid.querySelectorAll('button')];
				const next = all[all.indexOf(document.activeElement) + step];
				if (next && !next.disabled) next.focus();
			});

			// guests select
			const gField = document.getElementById('guests-btn').closest('[data-pop]');
			const gBtn = document.getElementById('guests-btn');
			const gVal = document.getElementById('guests-val');
			const gList = document.getElementById('guests-list');
			const gInput = gField.querySelector('input[name="guests"]');
			const opts = [...Array.from({ length: 11 }, (_, i) => `${i + 2} guests`), 'More than 12'];
			opts.forEach((o) => {
				const li = document.createElement('li');
				li.role = 'option'; li.tabIndex = -1; li.textContent = o; li.setAttribute('aria-selected', 'false');
				gList.append(li);
			});
			const pickG = (li) => {
				gList.querySelectorAll('li').forEach((x) => x.setAttribute('aria-selected', String(x === li)));
				gInput.value = li.textContent; gVal.textContent = li.textContent; gVal.classList.remove('ph');
				setOpen(gField, false); gBtn.focus();
			};
			const openG = () => { setOpen(gField, true); (gList.querySelector('[aria-selected="true"]') || gList.firstElementChild).focus(); };
			gBtn.addEventListener('click', () => (gList.hidden ? openG() : setOpen(gField, false)));
			gBtn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); openG(); } });
			gList.addEventListener('click', (e) => { const li = e.target.closest('li'); if (li) pickG(li); });
			gList.addEventListener('keydown', (e) => {
				const li = document.activeElement;
				if (e.key === 'ArrowDown') { e.preventDefault(); li.nextElementSibling?.focus(); }
				else if (e.key === 'ArrowUp') { e.preventDefault(); li.previousElementSibling?.focus(); }
				else if (e.key === 'Home') { e.preventDefault(); gList.firstElementChild.focus(); }
				else if (e.key === 'End') { e.preventDefault(); gList.lastElementChild.focus(); }
				else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pickG(li); }
				else if (e.key === 'Tab') setOpen(gField, false);
			});

			// enquiry: compose an email, no backend needed
			const form = document.querySelector('.enquiry');
			const status = form.querySelector('.status');
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				if (!form.checkValidity()) {
					form.reportValidity();
					status.textContent = 'Please add your name and a valid email so we can reply.';
					return;
				}
				const d = Object.fromEntries(new FormData(form));
				const body = `Name: ${d.name}\nEmail: ${d.email}\nDate: ${d.date || 'flexible'}\nGuests: ${d.guests || 'not sure yet'}\n\n${d.message || ''}`;
				status.textContent = 'Opening your email app with the enquiry ready to send.';
				location.href = `mailto:events@olivia.example?subject=${encodeURIComponent('Private dining enquiry')}&body=${encodeURIComponent(body)}`;
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
