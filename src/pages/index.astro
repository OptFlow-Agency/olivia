	.enquiry h3 { font-size: 2.2rem; }
	.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.field { position: relative; display: grid; gap: 0.5rem; }
	.lbl { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--stone); }
	.field input, .field textarea, .ctl { width: 100%; font: 400 1rem var(--sans); color: var(--paper); background: rgb(230 229 220 / 0.05); border: 1px solid rgb(140 134 126 / 0.7); border-radius: 2px; padding: 0.85rem 1rem; min-height: 3.1rem; transition: border-color 0.25s, background-color 0.25s; color-scheme: dark; }
	.field textarea { resize: vertical; min-height: 6.5rem; }
	.field ::placeholder { color: var(--taupe); opacity: 1; }
	.field input:hover, .field textarea:hover, .ctl:hover { border-color: var(--stone); }
	.field input:focus-visible, .field textarea:focus-visible, .ctl:focus-visible, .ctl[aria-expanded='true'] { outline: 0; border-color: var(--paper); background: rgb(230 229 220 / 0.09); box-shadow: 0 0 0 1px var(--paper); }
	.field input:user-invalid { border-color: #d8a48a; }
	.ctl { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; text-align: left; cursor: pointer; }
	.ctl svg { flex: none; fill: none; stroke: var(--stone); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.3s var(--ease); }
	.ctl[aria-expanded='true'] svg { stroke: var(--paper); }
	#guests-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
	.val.ph { color: var(--taupe); }
	.pop { position: absolute; top: calc(100% + 0.4rem); left: 0; z-index: 30; background: var(--walnut); border: 1px solid var(--tan); border-radius: 3px; box-shadow: 0 1.25rem 2.5rem rgb(0 0 0 / 0.45); animation: popin 0.3s var(--ease); }
	.pop[hidden] { display: none; }
